# Local MongoDB connection. Replace with a URI for a database you control.
MONGODB_URI=mongodb://127.0.0.1:27017/edutrace

# Replace with a newly generated private random secret. Never commit .env.local.
JWT_SECRET=replace_with_a_private_random_secret

# Optional. Leave blank to use the built-in non-LLM paths.
OPENAI_API_KEY=

# Optional redirect origin for the demo-login route.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
